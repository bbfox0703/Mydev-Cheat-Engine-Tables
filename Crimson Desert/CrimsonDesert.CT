INJECT_ITEM_REMOVE_NO_DECo:
  readmem(INJECT_ITEM_REMOVE_NO_DEC, $10)

newmem:
  push r13
  // min amount gating for specific items

  cmp qword ptr [r14+rcx+8], Copper  // Copper
  jne short @F
  cmp qword ptr [r14+rcx+10], #98000
  jae short @F
  mov qword ptr [r14+rcx+10], #98000

@@: // Cogwheel齒輪零件, Small Battery, Lubricant, Clockwork Insect機械蟲
  cmp qword ptr [r14+rcx+8], Cogwheel
  jb short @F
  cmp qword ptr [r14+rcx+8], Clockwork_Insect
