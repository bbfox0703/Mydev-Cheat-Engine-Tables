aobscanmodule(INJECT_ITEM_REMOVE_NO_DEC,$process,?? 29 ?? 0E 10 ?? 8B ?? ?? 01 ?? 66 ?? 3B ?? 08)
// raw AOB: 66 41 39 DD 0F 84 ?? ?? ?? ?? 48 8B 52 10 48 85 D2 7E ?? 4C 8B 7C 24 78 4C 39 FA 7D ?? 8B 05 ?? ?? ?? ?? EB ?? 45 0F B6 C4 48 89 6C 24 50 0F B7 CB E8 ?? ?? ?? ?? 48 8B 0F 48 89 C5 4D 29 7C 0E 10 48 8B 0F 4C 01 F1 66 44 3B 69 08 74 ?? 48 83 79 10 00 7E ?? 48 8B 51 10 45 0F B6 C4 0F B7 CB E8 ?? ?? ?? ?? 48 29 C5 C7 06 00 00 00 00 66 29 6F 12 48 8B 6C 24 50 EB ?? E8
// injection point AOB: ?? 29 ?? 0E 10 ?? 8B ?? ?? 01 ?? 66 ?? 3B ?? 08 74 ?? ?? 83 ?? 10 00 7E ?? ?? 8B ?? 10 ?? 0F B6 ?? 0F B7 ?? E8 ?? ?? ?? ?? ?? 29 ?? C7 ?? 00 00 00 00 66 29 ?? 12 ?? 8B ?? ?? ?? EB ?? E8
